{
  "name": "classcontrol-agent",
  "version": "2.2.0",
  "description": "ClassControl Agent — программа на компьютере ученика",
  "main": "main.js",
  "author": "Kilus",
  "scripts": {
    "start": "electron .",
    "config": "electron . --config",
    "build": "electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux"
  },
  "build": {
    "appId": "com.classcontrol.agent",
    "productName": "ClassControl Agent",
    "directories": {
      "output": "../dist/agent"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json",
      "platform/**"
    ],
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "menuCategory": "ClassControl",
      "shortcutName": "ClassControl Agent",
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Учитель видит экран этого компьютера во время урока."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "assets/icon.png"
    },
    "artifactName": "ClassControl-Agent-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "nsis": "1.2.1",
      "wine": "1.0.1",
      "winCodeSign": "1.1.0"
    }
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.0.0"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suleyman-sheripov/ClassControl-by-Kilus.git"
  }
}
