{
  "name": "classcontrol-teacher",
  "version": "2.2.0",
  "description": "ClassControl — приложение учителя",
  "main": "main.js",
  "author": "Kilus",
  "scripts": {
    "start": "electron .",
    "prebuild": "node ../scripts/prepare-build.js",
    "build": "electron-builder",
    "build:win": "npm run build -- --win",
    "build:mac": "npm run build -- --mac",
    "build:linux": "npm run build -- --linux"
  },
  "build": {
    "appId": "com.classcontrol.teacher",
    "productName": "ClassControl",
    "directories": {
      "output": "../dist/teacher"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!test/**",
          "!data/**",
          "!uploads/**",
          "!node_modules/socket.io-client/**"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!socket.io-client/**",
          "!**/*.md",
          "!**/test/**"
        ]
      },
      {
        "from": "../online",
        "to": "online"
      },
      {
        "from": "../shared",
        "to": "shared"
      },
      {
        "from": "../bin/${os}-${arch}",
        "to": "bin",
        "filter": [
          "cloudflared*",
          "integrity.json",
          "LICENSE-cloudflared.txt"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClassControl"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Микрофон учителя используется для эфира и записи урока.",
        "NSScreenCaptureUsageDescription": "Экран и выбранные окна используются для демонстрации ученикам и записи урока."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "assets/icon.png"
    },
    "artifactName": "ClassControl-${version}-${os}-${arch}.${ext}",
    "beforePack": "build/before-pack.js",
    "toolsets": {
      "nsis": "1.2.1",
      "wine": "1.0.1",
      "winCodeSign": "1.1.0"
    }
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/suleyman-sheripov/ClassControl-by-Kilus.git"
  }
}
